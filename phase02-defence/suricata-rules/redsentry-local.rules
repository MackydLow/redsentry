# Rule 1 — vsftpd backdoor trigger detection
# The :) smiley in the FTP USER command is the backdoor trigger
alert tcp any any -> $HOME_NET 21 (msg:"REDSENTRY vsftpd 2.3.4 Backdoor Trigger - Smiley Username"; \
    flow:to_server,established; content:"USER "; content:":)"; within:30; \
    reference:cve,2011-2523; \
    classtype:trojan-activity; sid:9000001; rev:1;)

# Rule 2 — vsftpd backdoor shell on port 6200
alert tcp $HOME_NET 6200 -> any any (msg:"REDSENTRY vsftpd Backdoor Shell - Root Connection Port 6200"; \
    flow:established,to_client; \
    reference:cve,2011-2523; \
    classtype:successful-recon-limited; sid:9000002; rev:1;)

# Rule 3 — Samba usermap_script exploitation
# Shell metacharacters in SMB NTLMSSP username
alert tcp any any -> $HOME_NET 139 (msg:"REDSENTRY Samba usermap_script Exploit - Shell Metachar in Username"; \
    flow:to_server,established; content:"|00|/"; content:"|00 00|`"; within:50; \
    reference:cve,2007-2447; \
    classtype:attempted-admin; sid:9000003; rev:1;)

# Rule 4 — UnrealIRCd backdoor command
alert tcp any any -> $HOME_NET 6667 (msg:"REDSENTRY UnrealIRCd Backdoor Command - AB Prefix"; \
    flow:to_server,established; content:"AB\;"; offset:0; depth:3; \
    reference:cve,2010-2075; \
    classtype:trojan-activity; sid:9000004; rev:1;)

# Rule 5 — Nmap OS detection (SYN scan fingerprint)
alert tcp any any -> $HOME_NET any (msg:"REDSENTRY Nmap SYN Scan Detected"; \
    flags:S; threshold:type threshold,track by_src,count 20,seconds 2; \
    classtype:attempted-recon; sid:9000005; rev:1;)

# Rule 6 — SSH brute force from external host
alert tcp $EXTERNAL_NET any -> $HOME_NET 22 (msg:"REDSENTRY SSH Brute Force - Multiple Auth Failures"; \
    flow:to_server,established; content:"SSH"; threshold:type threshold,track by_src,count 5,seconds 60; \
    classtype:attempted-admin; sid:9000006; rev:1;)

# Rule 7 — SQLi pattern in HTTP request
alert http any any -> $HOME_NET 80 (msg:"REDSENTRY SQL Injection Pattern Detected - OR 1=1"; \
    flow:to_server,established; http.uri; content:"OR"; nocase; content:"1=1"; nocase; within:20; \
    classtype:web-application-attack; sid:9000007; rev:1;)

# Rule 8 — Command injection in HTTP request
alert http any any -> $HOME_NET 80 (msg:"REDSENTRY Command Injection - Semicolon Command in HTTP"; \
    flow:to_server,established; http.uri; content:"\; "; content:"whoami"; nocase; distance:0; \
    classtype:web-application-attack; sid:9000008; rev:1;)
